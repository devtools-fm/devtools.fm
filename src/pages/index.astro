---
export const prerender = true;

import HomePage from "components/pages/HomePage";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLatestEp } from "utils/getLatestEp";

const latestEpisode = await getLatestEp();
const description = "A podcast about developer tools by the people who make them.";
---

<BaseLayout title="devtools.fm" description={description} canonical="/">
  <HomePage latestEpisode={latestEpisode} client:load />
</BaseLayout>
