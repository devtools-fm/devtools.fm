---
export const prerender = true;

import { SubscribeClient } from "components/pages/SubscribePage";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLatestEp } from "utils/getLatestEp";

const latestEpisode = await getLatestEp();
const description = "A podcast about developer tools by the people who make them.";
---

<BaseLayout title="devtools.fm - Subscribe" description={description} canonical="/subscribe">
  <SubscribeClient latestEpisode={latestEpisode} client:load />
</BaseLayout>
