{
  "$comment": "Fixed settings for the publish-episode pipeline (scripts/publish, .agents/skills/publish-episode). Secrets live in .env, not here.",
  "github": {
    "repo": "devtools-fm/devtools.fm"
  },
  "descript": {
    "apiBase": "https://descriptapi.com/v1",
    "$comment": "Projects are named by episode number. {N} is replaced with it; whitespace and case are ignored when matching.",
    "projectName": "{N}",
    "compositionNames": {
      "full": "{N}",
      "free": "{N} - Free"
    },
    "assets": {
      "$comment": "Brand files every episode project needs. Local copies live in assets/descript/; `episode:descript <N> brand` uploads any the project is missing.",
      "dir": "assets/descript",
      "$music": "Matches the 178 timeline: a quiet bed under speech, full volume over the frames. bedVolumeDb is estimated from the screenshot.",
      "bedVolumeDb": -18,
      "intro": {
        "frame": "Start Frame.png",
        "music": "devtools.fm (1).mp3",
        "seconds": 10,
        "tailSeconds": 11
      },
      "outro": {
        "frame": "end-frame-1.png",
        "music": "devtools.fm (1).mp3",
        "seconds": 10
      }
    },
    "$hostsComment": "Host name cards are fixed images in assets/descript/, uploaded by `brand`.",
    "hosts": [
      {
        "name": "Andrew Lisowski",
        "speaker": "Andrew",
        "card": "andrew-card.png"
      },
      {
        "name": "Justin Bennett",
        "speaker": "Justin",
        "card": "justin-card.png"
      }
    ],
    "videoResolution": "1080p",
    "adAfterMinutes": 15,
    "nameCard": {
      "$comment": "How the guest name card (pnpm episode:art <N> name-card) is placed in the video by Underlord.",
      "folder": "Name Cards",
      "position": "bottom left",
      "$size": "By height, so the host cards (which have transparent padding on the right) match the guest cards.",
      "heightPercentOfFrame": 20,
      "insetPercentOfFrame": 4,
      "fadeSeconds": 0.3,
      "mainConversationSeconds": 60
    }
  },
  "website": {
    "baseUrl": "https://devtools.fm"
  },
  "youtube": {
    "channelId": "UCFsRlOn7gODgv6WUriLrzXg",
    "categoryId": "28",
    "defaultLanguage": "en",
    "baseTags": [
      "devtools",
      "devtools fm",
      "podcast",
      "programming",
      "development",
      "technology"
    ],
    "freeFooter": [
      "Full show notes and transcript: {episodeUrl}",
      "",
      "Get the ad-free version and support the show: https://www.patreon.com/devtoolsfm",
      "Subscribe: https://www.youtube.com/channel/UCFsRlOn7gODgv6WUriLrzXg?sub_confirmation=1"
    ],
    "paidFooter": [
      "Thanks for supporting devtools.fm!",
      "Full show notes and transcript: {episodeUrl}"
    ]
  },
  "spotify": {
    "rssUrl": "https://anchor.fm/s/dd6922b4/podcast/rss",
    "dashboardUrl": "https://creators.spotify.com/pod/dashboard/episodes",
    "showUrl": "https://open.spotify.com/show/142I2b9HGjWhRgPXhOYUnN"
  },
  "patreon": {
    "creatorUrl": "https://www.patreon.com/devtoolsfm",
    "postUrl": "https://www.patreon.com/posts/new"
  },
  "browser": {
    "$comment": "A normal Chrome on this profile, started by `pnpm episode:browser` with a debugging port; agent-browser attaches with --cdp. ~ is expanded.",
    "profile": "~/.config/devtools-fm/browser-profile",
    "cdpPort": 9333
  },
  "art": {
    "$comment": "Fonts for the dynamic text on the thumbnail. Use a file (displayFont/monoFont) or an installed family (displayFamily/monoFamily); a file wins.",
    "displayFont": "assets/thumbnail/fonts/PaytoneOne-Regular.ttf",
    "displayFamily": "",
    "monoFont": "",
    "monoFamily": "Menlo",
    "chromePath": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
  },
  "buffer": {
    "$comment": "Channels in Buffer (publish.buffer.com) and how clip posts are shaped per network. threadLinks: links go in a thread reply; otherwise they're appended.",
    "channels": [
      {
        "network": "x",
        "id": "64f4f59230c6490ca76a02d0",
        "limit": 280,
        "threadLinks": true
      },
      {
        "network": "bluesky",
        "id": "66a9167b602872be45a5b25d",
        "limit": 300,
        "threadLinks": true
      },
      {
        "network": "threads",
        "id": "66a6cc72602872be45e02992",
        "limit": 500,
        "threadLinks": true
      },
      {
        "network": "mastodon",
        "id": "64f4f54830c6490ca7677336",
        "limit": 500,
        "threadLinks": true
      },
      {
        "network": "linkedin",
        "id": "64f4f5a430c6490ca76a521e",
