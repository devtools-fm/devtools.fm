{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": null,
  "outputDirectory": null,
  "installCommand": null,
  "devCommand": null,
  "redirects": [
    {
      "source": "/docs",
      "destination": "https://github.com/devtools-fm/devtools.fm/discussions",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "https://devtoolsfm.beehiiv.com/subscribe",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "mail.devtools.fm"
        }
      ]
    }
  ]
}
