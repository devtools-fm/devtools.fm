{
  "name": "devtools.fm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run standard-site:prepare-content && astro build && pnpm run build-rss",
    "build-rss": "node -r esbuild-register utils/generate-rss.ts",
    "start": "astro dev",
    "create-new-episode": "node -r esbuild-register scripts/create-new-episode.ts",
    "backfill-descriptions": "node -r esbuild-register scripts/backfill-descriptions.ts",
    "generate-episode-descriptions": "node -r esbuild-register scripts/generate-episode-descriptions.ts",
    "backfill-publish-dates": "node -r esbuild-register scripts/backfill-publish-dates.ts",
    "fix-malformed-spotify-aturi": "node -r esbuild-register scripts/fix-malformed-spotify-aturi.ts",
    "revert-spotify-lines": "node -r esbuild-register scripts/revert-spotify-lines.ts",
    "standard-site:prepare-content": "node -r esbuild-register scripts/generate-standard-site-content.ts",
    "sync-markpub-content": "node -r esbuild-register scripts/sync-markpub-content.ts",
    "publish:dry": "pnpm run standard-site:prepare-content && sequoia publish --dry-run && pnpm run sync-markpub-content -- --dry-run",
    "publish": "pnpm run standard-site:prepare-content && sequoia publish && pnpm run sync-markpub-content"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/vercel": "^11.0.8",
    "@atproto/api": "^0.18.21",
    "@devtools-ds/icon": "^1.2.1",
    "@devtools-ds/navigation": "^1.2.1",
    "@devtools-ds/object-inspector": "^1.2.1",
    "@devtools-ds/themes": "^1.2.1",
    "@radix-ui/react-label": "^2.0.2",
    "@reach/tabs": "0.12.1",
    "@vercel/analytics": "^1.0.1",
    "astro": "^7.2.9",
    "clsx": "^1.1.1",
    "googleapis": "^122.0.0",
    "gray-matter": "^4.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-window-ui": "^2.2.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rss": "^1.2.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/rss": "^0.0.31",
    "cheerio": "^1.0.0-rc.6",
    "esbuild": "^0.28.2",
    "esbuild-register": "^3.6.0",
    "isomorphic-fetch": "^3.0.0",
    "puppeteer": "^9.0.0",
    "sequoia-cli": "^0.5.7",
    "tailwindcss": "^4.1.11",
    "title-case": "^3.0.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.14.0"
}
